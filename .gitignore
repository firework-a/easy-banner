# =====================
# Go 语言核心规则
# =====================
# 二进制和可执行文件
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin

# 依赖和构建缓存
/go.sum
/go/pkg/
/vendor/
/.mod/
/.tmp/

# 测试相关
*.test
*.prof
*.cover
coverage.out
coverage.html

# =====================
# 项目特殊规则
# =====================
# 保留 assets/ 下的模板文件（重要例外！）
!/assets/
/assets/*
!*/default_banner.txt

# 忽略开发时生成的临时Banner
/tmp_*.txt

# =====================
# IDE 和编辑器配置
# =====================
# JetBrains
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Vim/Neovim
*.swp
*.swo
*.un~
*~

# =====================
# 操作系统元数据
# =====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*

# =====================
# 开发辅助文件
# =====================
# 环境变量
.env
.env.local
.env.*
!.env.example

# 调试文件
debug
*.debug

# 本地开发配置
.devcontainer/
local_config.yaml

# =====================
# 构建和发布系统
# =====================
# GoReleaser
dist/
artifacts/
*.snap
*.deb
*.rpm

# Docker
docker-compose.override.yml
/.dockerignore